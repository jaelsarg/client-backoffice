@using Howestprime.Backoffice.ViewModels.Planning

<div class="modal-content">
    <div class="modal-header">
    <i class="fa-solid fa-clapperboard"></i>
    <h2>Add Movie Event</h2>
    </div>
    <!-- The form to choose Room, Time, Movie -->
    <form class="modal-form" id="modalForm">
    <input type="hidden" id="modalDay" />
    <input type="hidden" id="modalMonth" />
    <input type="hidden" id="modalYear" />
    
    <div class="form-group">
        <label for="modalRoom">Room</label>
        <select id="modalRoom" class="form-control" required @bind="selectedRoom">
        <option value="">-- Choose a Room --</option>
        @foreach (var room in rooms)
        {
            <option value="@room.Id">@room.Name</option>
        }
        </select>
    </div>
    
    <div class="form-group">
        <label for="modalTime">Time</label>
        <select id="modalTime" class="form-control" required @bind="selectedTime">
        <option value="">-- Choose a Time --</option>
        <option value="15:00">15:00</option>
        <option value="19:00">19:00</option>
        </select>
    </div>
    
    <div class="form-group">
        <label for="modalMovie">Movie</label>
        <select id="modalMovie" class="form-control" required @bind="selectedMovie">
        <option value="">-- Choose a Movie --</option>
        <option value="8f247c7d-953b-447c-be6f-ef405316b938">Dune</option>
        <option value="Star Wars">Star Wars</option>
        <option value="Inception">Inception</option>
        <option value="Interstellar">Interstellar</option>
        <option value="Mulan">Mulan</option>
        </select>
    </div>
    
    <button type="submit" class="modal-submit-btn" @onclick="() => SaveEvent()">Save Event</button>
    </form>
</div>

@code {
    [Parameter]
    public int Day { get; set; }
    [Parameter]
    public int Month { get; set; }
    [Parameter]
    public int Year { get; set; }
    [Parameter]
    public IList<RoomViewModel> rooms { get; set; } = [];
    [Parameter]
    public EventCallback<EventViewModel> SaveNewEvent { get; set; }
    public string selectedRoom;
    private string selectedTime;
    private string selectedMovie;

    public async Task SaveEvent()
    {
        EventViewModel eventModel = new EventViewModel
        {
            MovieId = selectedMovie,
            RoomId = selectedRoom,
            ShowTime = new DateTime(Year, Month, Day).Add(TimeSpan.Parse(selectedTime)) 
        };
        await SaveNewEvent.InvokeAsync(eventModel);
    }
}