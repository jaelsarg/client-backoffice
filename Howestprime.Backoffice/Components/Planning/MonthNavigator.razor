@using System.Globalization

<div class="month-nav">
    <button class="prev-month" @onclick="() => OnMonthChange.InvokeAsync(-1)">&larr;</button>
    <h2 class="month-year" id="monthYear">@month @year</h2>
    <button class="next-month" @onclick="() => OnMonthChange.InvokeAsync(1)">&rarr;</button>
</div>

@code
{
    [Parameter]
    public string month { get; set; }

    [Parameter]
    public int year { get; set; }

    [Parameter]
    public EventCallback<int> OnMonthChange { get; set; }
}