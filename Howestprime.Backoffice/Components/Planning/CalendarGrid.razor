@using System.Globalization
@using System.CodeDom.Compiler
@using System.Runtime.InteropServices
@using Howestprime.Backoffice.ViewModels.Planning

<!-- Day-of-week Header (7 cells for Sun..Sat) -->
<div class="calendar-grid">
    <div class="day-name">Sun</div>
    <div class="day-name">Mon</div>
    <div class="day-name">Tue</div>
    <div class="day-name">Wed</div>
    <div class="day-name">Thu</div>
    <div class="day-name">Fri</div>
    <div class="day-name">Sat</div>
</div>

<!-- Actual day cells go here (dynamically, no blanks) -->
<div class="calendar-grid" id="calendarDays">
    @foreach (DayViewModel day in daysInMonth){
        <div class="@(day.IsEmpty ? "empty-cell" : "day-cell date-number") @(day.IsDisabled ? "disabled-day" : "")" @onclick="() => OnDayClick(day)">
            @day.Day
            @if (day.MovieEvents.Any())
            {
                @foreach (EventViewModel movieEvent in day.MovieEvents)
                {
                    <div class="event @(movieEvent.RoomName == "Blue Room" ? "event-blue-room" : "event-yellow-room")">
                        @movieEvent.ShowTime.ToString("HH:mm") - @movieEvent.MovieTitle
                    </div>
                }
            }
        </div>
    }
</div>

@code
{
    [Parameter]
    public IList<DayViewModel> daysInMonth { get; set; }
    [Parameter]
    public EventCallback<DayViewModel> ShowEventModal { get; set; }

    private async Task OnDayClick(DayViewModel day)
    {
        if (!day.IsDisabled) await ShowEventModal.InvokeAsync(day);
    }
}