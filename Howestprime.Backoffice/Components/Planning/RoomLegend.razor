@using Howestprime.Backoffice.ViewModels.Planning

<div class="room-legend">
    @foreach (var room in rooms){
        <div class="room-legend-item">
            <div class="room-legend-color @(room.Name == "Blue Room" ? "room-legend-blue" : "room-legend-yellow")"></div>
            <span>@room.Name</span>
        </div>
    }
</div>

@code {
    [Parameter]
    public IList<RoomViewModel> rooms { get; set; } = [];
}