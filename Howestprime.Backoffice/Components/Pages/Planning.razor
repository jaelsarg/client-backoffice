@page "/"
@using Howestprime.Backoffice.Components.Planning
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<main class="app-content">
  <div class="month-nav-container">

    <RoomLegend rooms="@Rooms" />

    <MonthNavigator
        month="@monthName"
        year="@year"
        OnMonthChange="OnMonthChange" />

    <div style="width: 100px;"></div>
  </div>

  <CalendarGrid
    daysInMonth="@DaysInMonth"
    ShowEventModal="ShowEventModal" />

  <div class="modal-overlay @(selectedDay?.ShowEventModal == true ? "active" : "")" id="addEventModal" @onclick="HideEventModal">
    <div class="modal-content" @onclick:stopPropagation>

      <EventModal 
        Rooms="@Rooms"
        Movies="@Movies"/>

    </div>
  </div>

</main>