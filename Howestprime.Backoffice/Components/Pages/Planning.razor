@page "/"
@using Howestprime.Backoffice.Components.Planning
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<main class="app-content">
  <div class="month-nav-container">
    <RoomLegend rooms="@Rooms" />
    <MonthNavigator @ref="MonthNavigator" month="@month" year="@year" OnMonthChange="OnMonthChange" />
    <div style="width: 100px;"></div>
  </div>

  <CalendarGrid @ref="CalendarGrid" ShowEventModal="ShowEventModal" />

  <div class="modal-overlay @(isShowingEventModal ? "active" : "")" id="addEventModal" >
    <EventModal 
              day="@selectedDate.Day"
              month="@selectedDate.Month"
              year="@selectedDate.Year"
              rooms="@Rooms"
              movies="@Movies"
              SaveNewEvent="SaveNewEvent" />
  </div>
</main>